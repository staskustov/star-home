generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Snapshot {
  id        String @id
  body      Json
  version   Int    @default(0)
  projected Int    @default(0)
}

model LoginAttempt {
  login String   @id
  count Int
  until DateTime
}

model Meter {
  id        String @id
  companyId String
  objectId  String
  unitId    String
  name      String
  unit      String
}

model MeterReading {
  id      String @id
  meterId String
  value   Float
  at      String
}

model StoredFile {
  id        String  @id
  companyId String
  objectId  String
  requestId String?
  name      String
  path      String
  data      Bytes?
}

model PushSubscription {
  id       String @id
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String
}

model Company {
  id   String @id
  name String
}

model Role {
  name String @id
}

model User {
  id           String  @id
  login        String
  name         String
  passwordHash String
  email        String  @default("")
  phone        String  @default("")
  status       String  @default("ACTIVE")
  lastLoginAt  String?
}

model Membership {
  id        String  @id
  userId    String
  companyId String
  role      String
  objectId   String?
  buildingId String?
  unitId     String?
  expiresAt  String?
  passId     String?
  status     String  @default("ACTIVE")
  createdAt String?
  createdBy String?
}

model Resident {
  id        String @id
  userId    String
  companyId String
  objectId  String
  unitId    String
  name      String
}

model FamilyMember {
  id        String @id
  userId    String
  companyId String
  objectId  String
  unitId    String
  name      String
}

model ResidentialObject {
  id        String @id
  companyId String
  name      String
  type      String
  address   String
}

model Building {
  id       String @id
  objectId String
  name     String
  number   String
}

model Unit {
  id         String  @id
  objectId   String
  buildingId String?
  name       String
  number     String
  type       String
}

model Visitor {
  id     String @id
  name   String
  passId String
}

model VisitorPass {
  id        String @id
  companyId String
  objectId  String
  unitId    String
  guestName String
  detail    String
  vehicle   String
  code      String
}

model Vehicle {
  id     String @id
  passId String
  plate  String
}

model AccessEvent {
  id        String  @id
  companyId String
  objectId  String
  unitId    String?
  time      String
  title     String
  result    String
}

model Device {
  id        String  @id
  companyId String
  objectId  String
  unitId    String?
  kind      String
  name      String
  adapter   String
}

model DeviceState {
  deviceId         String @id
  state            String
  temperatureC     Float?
  humidityPercent  Float?
}

model Automation {
  id       String @id
  objectId String
  mode     String
  climate  String
  lighting String
  security String
}

model LifeModeSetting {
  id       String @id
  objectId String
  mode     String
  label    String
  summary  String
}

model LifeModeActive {
  unitId String @id
  mode   String
}

model SecurityEvent {
  id        String @id
  companyId String
  objectId  String
  unitId    String
  title     String
  status    String
  at        String
  handledBy String?
  handledAt String?
}

model Invoice {
  id        String @id
  companyId String
  objectId  String
  unitId    String
  title     String
  amount    Int
  currency  String
  status    String
}

model Payment {
  id        String @id
  invoiceId String @unique
  amount    Int
  currency  String
  status    String
}

model ServiceRequest {
  id           String @id
  companyId    String
  objectId     String
  unitId       String
  authorUserId String
  category     String
  text         String
  status       String
}

model Notification {
  id        String @id
  companyId String
  userId    String
  title     String
  body      String
  at        String
}

model AiMessage {
  id        String @id
  companyId String
  userId    String
  unitId    String
  prompt    String
  reply     String
}

model AuditLog {
  id           String  @id
  actorUserId  String
  actorRole    String?
  membershipId String?
  companyId    String
  objectId     String?
  buildingId   String?
  unitId       String?
  category     String?
  action       String
  targetType   String?
  targetId     String?
  target       String
  result       String
  error        String
  ip           String?
  device       String?
  changes      Json?
  at           String

  @@index([companyId, at])
  @@index([objectId, at])
}
